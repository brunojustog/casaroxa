# Banco de dados (Postgres via Docker Compose)
DATABASE_URL="postgresql://casaroxa:casaroxa@localhost:5432/casa_roxa?schema=public"

# Auth.js
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-isto-em-producao-use-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Seed do usuário admin (usado pelo prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@casaroxa.local"
SEED_ADMIN_PASSWORD="casa-roxa-2026"
SEED_ADMIN_NAME="Administrador"

# App
NEXT_PUBLIC_APP_NAME="Casa Roxa Gestão de Custos"

# Chat IA (Anthropic)
# Crie em https://console.anthropic.com/ → API Keys (mínimo $5 de crédito)
ANTHROPIC_API_KEY=""
# Modelo padrão (sonnet 4.6 recomendado para custo/qualidade)
ANTHROPIC_MODEL="claude-sonnet-4-6"
# Teto mensal opcional em USD (ex: 30 = ~R$150). Vazio = sem limite client-side.
AI_MONTHLY_BUDGET_USD="30"
