// Casa Roxa — Gestão — Prisma schema
// Veja README.md para instruções de bootstrap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  OPERADOR
}

enum IngredientCategory {
  CARNE
  TEMPERO
  ACOMPANHAMENTO
  EMBALAGEM
  BEBIDA
  LIMPEZA
  GAS
  OUTRO
}

enum IngredientUnit {
  KG
  G
  UNIDADE
  PACOTE
  LITRO
  ML
  PORCAO
  BOTIJAO
  CAIXA
}

enum ProductCategory {
  FRANGO
  COSTELA
  SUINOS
  ACOMPANHAMENTOS
  EXTRAS
  BEBIDAS
}

enum ProductType {
  SIMPLES
  ACOMPANHAMENTO
  EXTRA
  BEBIDA
  CARNE_PURA
}

enum ProductStatus {
  ATIVO
  INATIVO
  SOB_ENCOMENDA
}

enum SimulationTarget {
  PRODUTO
  COMBO
}

enum ImportStatus {
  PENDENTE
  SUCESSO
  PARCIAL
  FALHA
}

enum StockMovementType {
  ENTRADA // compra (quantity adiciona ao saldo)
  SAIDA // venda manual / consumo (quantity subtrai)
  PERDA // descarte / vencimento (quantity subtrai; também usar para ajuste negativo)
  AJUSTE // correção positiva do inventário (quantity adiciona; usar PERDA para correção negativa)
}

enum PurchaseStatus {
  RASCUNHO // editável, ainda não impactou estoque/custos
  CONFIRMADA // gerou movimentos de estoque + atualizou custos (se opt-in)
  CANCELADA // descartada (movimentos revertidos se já confirmada)
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum FixedCostCategory {
  ALUGUEL
  ENERGIA
  AGUA
  INTERNET
  FOLHA
  IMPOSTOS
  CONTADOR
  MARKETING
  EQUIPAMENTOS
  OUTROS
}

enum FixedCostFrequency {
  MENSAL // valor já é mensal
  ANUAL // valor anual; rateio /12 ao somar
}

enum SaleSource {
  LOJA
  IFOOD
  WHATSAPP
  SITE // pedido vindo do cardápio online (carrinho público)
  OUTRO
}

enum PaymentMethod {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  APP_IFOOD
  APP_OUTRO
  OUTRO
}

enum SaleStatus {
  ABERTA // sendo montada, ainda editável; não impactou estoque
  CONCLUIDA // fechada, gerou SAIDA no estoque
  CANCELADA // descartada (revertida com AJUSTE se já tinha gerado movimento)
}

enum SaleProgress {
  NOVO // pedido caiu, admin ainda não revisou
  CONFIRMADO // admin viu e validou
  PREPARANDO // em produção
  PRONTO // pronto para retirada / saída
  SAIU_ENTREGA // delivery em rota
  ENTREGUE // finalizado
}

enum InventoryStatus {
  ABERTA // contagem em andamento, ainda pode editar itens
  FECHADA // já gerou os ajustes de estoque (imutável)
  CANCELADA // descartada antes de fechar (sem efeito no estoque)
}

enum CouponType {
  PERCENT // value entre 0..100 (ex.: 10 = 10% off)
  FIXED // value em reais (ex.: 5 = R$ 5 off)
}

enum SalesEventStatus {
  DRAFT // rascunho — não exposto no site
  OPEN // aberto pra pedidos
  CLOSED // encerrou inscrições (cozinha produzindo / entregando)
  CANCELLED // cancelado
}

enum SalesEventWindowKind {
  PICKUP // retirada na loja
  DELIVERY // entrega
}

enum CampaignChannel {
  WHATSAPP
  EMAIL // futuro
}

enum CampaignAudienceKey {
  BIRTHDAY_MONTH // aniversariantes do mês corrente
  INACTIVE_30D // sem pedido CONCLUIDO nos últimos 30 dias
  RECURRING // >= 3 pedidos concluídos
  HIGH_TICKET // ticket médio acima de Settings.targetAverageTicket
  BOUGHT_CHICKEN // já comprou pelo menos 1 produto categoria FRANGO
  BOUGHT_BEEF_RIB // já comprou pelo menos 1 produto categoria COSTELA
}

enum CampaignStatus {
  DRAFT // ainda não disparada
  DISPATCHING // disparo em andamento
  SENT // todos os envios processados
  CANCELLED // cancelada antes de terminar
}

enum CampaignDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ============================================================
// AUTENTICAÇÃO
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERADOR)
  /// Se false, login bloqueado (sem deletar — preserva FKs em vendas/movimentos).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredientPriceChanges IngredientPriceHistory[]
  recipesReviewed        Recipe[]                 @relation("RecipeReviewer")
  settingsChanges        SettingsHistory[]
  stockMovements         StockMovement[]
  purchases              Purchase[]
  chatConversations      ChatConversation[]
  fixedCostItems         FixedCostItem[]
  fixedCostChanges       FixedCostItemHistory[]
  salesCreated           Sale[]                   @relation("SaleCreatedBy")
  salesClosed            Sale[]                   @relation("SaleClosedBy")
  salesCancelled         Sale[]                   @relation("SaleCancelledBy")
  inventoriesCreated     Inventory[]              @relation("InventoryCreatedBy")
  inventoriesClosed      Inventory[]              @relation("InventoryClosedBy")
  inventoryItemsCounted  InventoryItem[]
  pushSubscriptions      PushSubscription[]
  rafflesDrawn           Raffle[]                 @relation("RaffleDrawnBy")
  salesEventsCreated     SalesEvent[]             @relation("SalesEventCreatedBy")
  orderRequestsCreated   OrderRequest[]           @relation("OrderRequestCreatedBy")
  orderRequestsApproved  OrderRequest[]           @relation("OrderRequestApprovedBy")
  campaignsCreated       Campaign[]               @relation("CampaignCreatedBy")
}

// ============================================================
// WHATSAPP (envios via wuzapi)
// ============================================================

enum WhatsAppEvent {
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_ON_DELIVERY
  BIRTHDAY_COUPON
  LOYALTY_REDEEM
  OTP // código de verificação pra "Já sou cliente" no checkout
  RAFFLE_WIN // ganhador de sorteio
  PAYMENT_RECEIVED // pagamento online recebido (Asaas)
  ORDER_REQUEST_RECEIVED // encomenda criada — confirmação automática
  ORDER_REQUEST_APPROVED // admin aprovou encomenda
  ORDER_REQUEST_REJECTED // admin recusou
  ORDER_REQUEST_READY // encomenda PRONTA pra retirada/entrega
  MANUAL // disparado pelo chat IA ou botão manual
  TEST // botão "Testar conexão" em /configuracoes
}

enum WhatsAppMessageStatus {
  SENT
  FAILED
  SKIPPED // kill switch off ou config faltando
}

model WhatsAppMessageLog {
  id           String                @id @default(cuid())
  customerId   String?
  saleId       String?
  /// Telefone destino, normalizado (só dígitos com DDI). Ex.: "5511999999999".
  phone        String
  event        WhatsAppEvent
  message      String
  status       WhatsAppMessageStatus
  /// Mensagem de erro do servidor (se status=FAILED).
  errorMessage String?
  /// ID da mensagem retornado pelo wuzapi (se status=SENT).
  externalId   String?
  createdAt    DateTime              @default(now())

  @@index([customerId, createdAt])
  @@index([event, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// PUSH NOTIFICATIONS (Web Push API)
// ============================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// Endpoint único do navegador (vem da Web Push API).
  endpoint  String   @unique
  /// Chave pública do cliente (p256dh) — necessária pra criptografar payload.
  p256dh    String
  /// Chave de autenticação do cliente.
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================
// INGREDIENTES
// ============================================================

model Ingredient {
  id           String             @id @default(cuid())
  name         String             @unique
  category     IngredientCategory
  unit         IngredientUnit
  unitCost     Decimal            @db.Decimal(12, 4)
  packageSize  Decimal?           @db.Decimal(10, 4)
  packagePrice Decimal?           @db.Decimal(12, 4)
  supplier     String?
  brand        String?
  notes        String?
  active       Boolean            @default(true)
  lastPriceAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  /// Estoque mínimo desejado (unidade igual à do ingrediente). Quando o
  /// saldo cai abaixo, aparece como alerta no dashboard e fica destacado
  /// em /estoque. null = sem alerta configurado.
  minStock Decimal? @db.Decimal(12, 4)

  recipeItems    RecipeItem[]
  priceHistory   IngredientPriceHistory[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  inventoryItems InventoryItem[]

  @@index([category, active])
}

model IngredientPriceHistory {
  id           String   @id @default(cuid())
  ingredientId String
  oldPrice     Decimal  @db.Decimal(12, 4)
  newPrice     Decimal  @db.Decimal(12, 4)
  changedAt    DateTime @default(now())
  changedById  String?

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  changedBy  User?      @relation(fields: [changedById], references: [id])

  @@index([ingredientId, changedAt])
}

// ============================================================
// PRODUTOS
// ============================================================

model Product {
  id                String          @id @default(cuid())
  name              String          @unique
  category          ProductCategory
  type              ProductType     @default(SIMPLES)
  portionLabel      String?
  salePrice         Decimal?        @db.Decimal(12, 2)
  targetCmv         Decimal?        @db.Decimal(5, 4)
  description       String?
  notes             String?
  status            ProductStatus   @default(ATIVO)
  active            Boolean         @default(true)
  totalCost         Decimal         @default(0) @db.Decimal(12, 4)
  /// URL pública da foto (relativa, ex: /menu/frango.jpg, ou absoluta).
  imageUrl          String?
  /// Se true, aparece no cardápio online público.
  showInMenu        Boolean         @default(false)
  /// Texto livre com ingredientes visível ao cliente (ex: "Frango caipira, alho, cebola, sal grosso").
  /// Distinto da Recipe interna que controla custos.
  ingredientsPublic String?
  /// Galeria de fotos adicionais (array de URLs em JSON). Aparece na página de detalhe.
  gallery           Json?
  /// URL do YouTube (qualquer formato). É convertida para embed na página de detalhe.
  youtubeUrl        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  recipe             Recipe?
  comboItems         ComboItem[]
  priceHistory       ProductPriceHistory[]
  saleItems          SaleItem[]
  salesEventProducts SalesEventProduct[]
  orderRequestItems  OrderRequestItem[]

  @@index([category, active])
  @@index([showInMenu, active])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal? @db.Decimal(12, 2)
  newPrice  Decimal? @db.Decimal(12, 2)
  changedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, changedAt])
}

// ============================================================
// FICHAS TÉCNICAS
// ============================================================

model Recipe {
  id           String    @id @default(cuid())
  productId    String    @unique
  reviewed     Boolean   @default(false)
  reviewedAt   DateTime?
  reviewedById String?
  responsible  String?
  notes        String?
  totalCost    Decimal   @default(0) @db.Decimal(12, 4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("RecipeReviewer", fields: [reviewedById], references: [id])
  items      RecipeItem[]
  versions   RecipeVersion[]
}

model RecipeItem {
  id               String         @id @default(cuid())
  recipeId         String
  ingredientId     String
  quantity         Decimal        @db.Decimal(10, 4)
  unit             IngredientUnit
  unitCostSnapshot Decimal        @db.Decimal(12, 4)
  totalCost        Decimal        @db.Decimal(12, 4)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

model RecipeVersion {
  id        String   @id @default(cuid())
  recipeId  String
  version   Int
  snapshot  Json
  notes     String?
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, version])
}

// ============================================================
// COMBOS
// ============================================================

model Combo {
  id                String          @id @default(cuid())
  name              String          @unique
  category          ProductCategory
  description       String?
  salePrice         Decimal?        @db.Decimal(12, 2)
  targetCmv         Decimal?        @db.Decimal(5, 4)
  notes             String?
  active            Boolean         @default(true)
  totalCost         Decimal         @default(0) @db.Decimal(12, 4)
  /// URL pública da foto (relativa, ex: /menu/combo.jpg, ou absoluta).
  imageUrl          String?
  /// Se true, aparece no cardápio online público.
  showInMenu        Boolean         @default(false)
  /// Texto livre com ingredientes visível ao cliente.
  ingredientsPublic String?
  /// Galeria de fotos adicionais (array de URLs em JSON).
  gallery           Json?
  /// URL do YouTube convertida para embed na página de detalhe.
  youtubeUrl        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  saleItems          SaleItem[]
  salesEventProducts SalesEventProduct[]
  orderRequestItems  OrderRequestItem[]

  items ComboItem[]

  @@index([showInMenu, active])
}

model ComboItem {
  id               String   @id @default(cuid())
  comboId          String
  productId        String
  quantity         Decimal  @db.Decimal(10, 4)
  unitCostSnapshot Decimal  @db.Decimal(12, 4)
  totalCost        Decimal  @db.Decimal(12, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([comboId])
  @@index([productId])
}

// ============================================================
// CONFIGURAÇÕES (singleton)
// ============================================================

model Settings {
  id                     Int     @id @default(1)
  businessName           String  @default("Casa Roxa Assados")
  fixedMonthlyCost       Decimal @default(1500) @db.Decimal(12, 2)
  investedAmount         Decimal @default(5000) @db.Decimal(12, 2)
  plannedInvestment      Decimal @default(5000) @db.Decimal(12, 2)
  targetAverageTicket    Decimal @default(75) @db.Decimal(10, 2)
  targetOrdersPerWeekend Int     @default(100)
  weekendsPerMonth       Int     @default(4)
  defaultCmvChicken      Decimal @default(0.50) @db.Decimal(5, 4)
  defaultCmvBeefRib      Decimal @default(0.50) @db.Decimal(5, 4)
  defaultCmvPork         Decimal @default(0.50) @db.Decimal(5, 4)
  defaultCmvSides        Decimal @default(0.35) @db.Decimal(5, 4)
  defaultCmvExtras       Decimal @default(0.35) @db.Decimal(5, 4)
  defaultCmvBeverages    Decimal @default(0.70) @db.Decimal(5, 4)
  defaultCmvCombos       Decimal @default(0.45) @db.Decimal(5, 4)
  cardFeePercent         Decimal @default(0) @db.Decimal(5, 4)
  appFeePercent          Decimal @default(0) @db.Decimal(5, 4)
  beefRibLossPercent     Decimal @default(0.35) @db.Decimal(5, 4)
  porkRibLossPercent     Decimal @default(0.30) @db.Decimal(5, 4)
  pancetaLossPercent     Decimal @default(0.30) @db.Decimal(5, 4)
  porkLoinLossPercent    Decimal @default(0.25) @db.Decimal(5, 4)

  // ----- Cardápio online -----
  /// Slogan que aparece no hero da landing pública.
  siteSlogan          String?
  /// Número WhatsApp completo (E.164 ou só dígitos, ex: 5511999999999).
  whatsappNumber      String?
  /// Endereço completo (rua, número, complemento).
  address             String?
  /// Bairro / Cidade.
  addressNeighborhood String?
  /// Texto livre com horários (ex: "Sáb e Dom 11h às 17h").
  openingHours        String?
  /// URL do Instagram (https://...).
  instagramUrl        String?
  /// URL do Facebook (https://...).
  facebookUrl         String?
  /// Habilita opção de retirada no checkout público.
  pickupEnabled       Boolean  @default(true)
  /// Habilita opção de delivery no checkout público.
  deliveryEnabled     Boolean  @default(true)
  /// Texto livre sobre taxa/área de entrega (ex: "Taxa conforme distância — combinamos no WhatsApp").
  deliveryFeeNote     String?
  /// Pedido mínimo opcional (em R$). Se null/0, sem mínimo.
  minimumOrderValue   Decimal? @db.Decimal(10, 2)

  // ----- Promoção em destaque (hero da landing) -----
  /// Título da promoção exibido em destaque no hero. Se vazio, mostra logo.
  heroPromoTitle     String?
  /// Texto descritivo da promoção.
  heroPromoText      String?
  /// URL da imagem da promoção.
  heroPromoImageUrl  String?
  /// Texto do botão CTA (ex: "Ver combos"). Se vazio, sem botão.
  heroPromoLinkLabel String?
  /// Para onde o botão leva (ex: /cardapio?cat=COMBOS). Se vazio, sem botão.
  heroPromoLinkHref  String?

  // ----- WhatsApp API (wuzapi) -----
  /// Master switch — se false, todas as notificações ficam desabilitadas
  /// independente dos toggles abaixo.
  whatsappApiEnabled                 Boolean @default(false)
  /// Notifica cliente quando admin marca pedido como CONFIRMADO.
  whatsappNotifyConfirmed            Boolean @default(false)
  /// Notifica cliente quando pedido vira PRONTO.
  whatsappNotifyReady                Boolean @default(false)
  /// Notifica cliente quando pedido vira SAIU_ENTREGA.
  whatsappNotifyOnDelivery           Boolean @default(false)
  /// Botão "WhatsApp" no card de aniversário envia direto via API.
  whatsappNotifyBirthday             Boolean @default(false)
  /// Avisa cliente quando bate 100 pts e ganha cupom de fidelidade.
  whatsappNotifyLoyaltyRedeem        Boolean @default(false)
  /// Avisa cliente quando o pagamento online é confirmado.
  whatsappNotifyPaymentReceived      Boolean @default(false)
  /// Confirmação automática ao cliente quando encomenda é criada.
  whatsappNotifyOrderRequestReceived Boolean @default(false)
  /// Avisa cliente quando admin aprova a encomenda.
  whatsappNotifyOrderRequestApproved Boolean @default(false)
  /// Avisa cliente quando admin recusa (com motivo).
  whatsappNotifyOrderRequestRejected Boolean @default(false)
  /// Avisa cliente quando encomenda vira PRONTA.
  whatsappNotifyOrderRequestReady    Boolean @default(false)

  // ----- Pagamento online (Asaas) -----
  /// Master switch — se false, opções de pagamento online ficam ocultas
  /// no checkout. Mesmo desligado, payments existentes continuam acessíveis
  /// (cliente que iniciou pagamento pode finalizar).
  asaasEnabled         Boolean @default(false)
  /// Quantas horas após a criação o cliente tem pra pagar (default 24h).
  /// Após isso o sistema marca como OVERDUE.
  asaasPaymentTtlHours Int     @default(24)

  // ----- Encomendas -----
  /// Antecedência mínima em horas pra uma encomenda ser aceita pelo site.
  /// Valida no /encomenda — cliente não pode pedir pra data anterior a now + N horas.
  orderLeadTimeHours Int @default(48)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history SettingsHistory[]
}

model SettingsHistory {
  id          String   @id @default(cuid())
  settingsId  Int
  snapshot    Json
  changedAt   DateTime @default(now())
  changedById String?

  settings  Settings @relation(fields: [settingsId], references: [id])
  changedBy User?    @relation(fields: [changedById], references: [id])
}

// ============================================================
// CENÁRIOS / SIMULAÇÕES
// ============================================================

model Scenario {
  id                  String   @id @default(cuid())
  name                String
  ordersPerWeekend    Int
  averageTicket       Decimal  @db.Decimal(10, 2)
  weekendsPerMonth    Int      @default(4)
  estimatedCmvPercent Decimal  @db.Decimal(5, 4)
  monthlyRevenue      Decimal  @db.Decimal(14, 2)
  grossProfit         Decimal  @db.Decimal(14, 2)
  fixedCost           Decimal  @db.Decimal(12, 2)
  estimatedResult     Decimal  @db.Decimal(14, 2)
  paybackMonths       Decimal? @db.Decimal(8, 2)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PriceSimulation {
  id                   String           @id @default(cuid())
  targetType           SimulationTarget
  productId            String?
  comboId              String?
  currentCost          Decimal          @db.Decimal(12, 4)
  currentPrice         Decimal?         @db.Decimal(12, 2)
  targetCmv            Decimal          @db.Decimal(5, 4)
  suggestedPrice       Decimal          @db.Decimal(12, 2)
  simulatedPrice       Decimal          @db.Decimal(12, 2)
  simulatedCmv         Decimal          @db.Decimal(5, 4)
  simulatedGrossProfit Decimal          @db.Decimal(12, 2)
  cardFeePercent       Decimal?         @db.Decimal(5, 4)
  appFeePercent        Decimal?         @db.Decimal(5, 4)
  discountPercent      Decimal?         @db.Decimal(5, 4)
  notes                String?
  createdAt            DateTime         @default(now())
}

// ============================================================
// IMPORTAÇÃO
// ============================================================

model ImportLog {
  id         String       @id @default(cuid())
  fileName   String
  status     ImportStatus
  summary    Json
  errors     Json?
  importedAt DateTime     @default(now())
}

// ============================================================
// ESTOQUE
// ============================================================

model StockMovement {
  id            String            @id @default(cuid())
  ingredientId  String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 4) // sempre positivo; o type indica direção
  unitCost      Decimal?          @db.Decimal(12, 4) // custo no momento (preenchido em ENTRADA)
  lotNumber     String?
  expiryDate    DateTime?
  notes         String?
  referenceType String? // "PURCHASE", "MANUAL", "SALE" etc. (futuro)
  referenceId   String?
  userId        String?
  createdAt     DateTime          @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id])

  @@index([ingredientId, createdAt])
  @@index([type, createdAt])
  @@index([expiryDate])
}

// ============================================================
// INVENTÁRIO (CONTAGEM FÍSICA)
// ============================================================

model Inventory {
  id          String          @id @default(cuid())
  /// Rótulo livre — ex.: "Inventário mensal — maio/26", "Câmara fria"
  name        String
  status      InventoryStatus @default(ABERTA)
  notes       String?
  createdById String
  closedById  String?
  startedAt   DateTime        @default(now())
  closedAt    DateTime?

  createdBy User            @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  closedBy  User?           @relation("InventoryClosedBy", fields: [closedById], references: [id])
  items     InventoryItem[]

  @@index([status, startedAt])
}

model InventoryItem {
  id               String    @id @default(cuid())
  inventoryId      String
  ingredientId     String
  /// Saldo do sistema no momento em que o item entrou na contagem (snapshot).
  /// Usado pra calcular a diferença ao fechar — não muda com novos movimentos.
  expectedQuantity Decimal   @db.Decimal(12, 4)
  /// O que o operador efetivamente contou. Null = ainda não contado.
  countedQuantity  Decimal?  @db.Decimal(12, 4)
  /// Custo unit. no snapshot, pra registrar em PERDA/AJUSTE no fechamento.
  unitCostSnapshot Decimal   @db.Decimal(12, 4)
  notes            String?
  countedAt        DateTime?
  countedById      String?
  createdAt        DateTime  @default(now())

  inventory  Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  countedBy  User?      @relation(fields: [countedById], references: [id])

  @@unique([inventoryId, ingredientId])
  @@index([ingredientId])
}

// ============================================================
// CUPONS DE DESCONTO
// ============================================================

// ============================================================
// CLIENTES
// ============================================================

model Customer {
  id                String    @id @default(cuid())
  name              String
  /// Chave natural — usada pra reconhecer o mesmo cliente em pedidos
  /// repetidos no checkout público (upsert por telefone).
  phone             String    @unique
  email             String?
  /// Aniversário (opcional). Usado pra promoções automáticas no futuro.
  birthday          DateTime? @db.Date
  /// Endereço padrão (opcional, alimenta o checkout pré-preenchido).
  address           String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  reference         String?
  notes             String?
  active            Boolean   @default(true)
  /// Pontos atuais do cartão fidelidade. Acumula 1 ponto por R$ 1 gasto
  /// em vendas concluídas, e zera/decrementa quando vira cupom de resgate.
  loyaltyPoints     Int       @default(0)
  /// ID do cliente no Asaas (cache pra não recriar a cada cobrança).
  asaasCustomerId   String?   @unique
  /// CPF (11 dígitos) ou CNPJ (14). Só dígitos. Pedido só quando o cliente
  /// escolhe pagar online (Asaas exige).
  cpfCnpj           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sales               Sale[]
  loyaltyTransactions LoyaltyTransaction[]
  sessions            CustomerSession[]
  raffleEntries       RaffleEntry[]
  onlinePayments      OnlinePayment[]
  referralsMade       RaffleReferral[]     @relation("ReferrerReferrals")
  referralsReceived   RaffleReferral[]     @relation("ReferredReferrals")
  orderRequests       OrderRequest[]
  campaignDeliveries  CampaignDelivery[]

  /// Cliente aceita receber comunicação de marketing (campanhas). Default
  /// true; futuro opt-out fica neste campo. Mensagens transacionais
  /// (confirmação, pagamento) ignoram esse flag.
  marketingOptIn Boolean @default(true)

  @@index([active, name])
  @@index([birthday])
}

// ============================================================
// AUTENTICAÇÃO LEVE DE CLIENTE (sem senha — OTP via WhatsApp)
// ============================================================

model OtpChallenge {
  id         String    @id @default(cuid())
  /// Telefone normalizado com DDI (ex.: 5511999999999).
  phone      String
  /// Hash bcrypt do código de 6 dígitos (nunca armazenado em texto).
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model CustomerSession {
  id         String   @id @default(cuid())
  /// Token opaco aleatório (32 bytes hex). Armazenado em cookie httpOnly.
  token      String   @unique
  customerId String
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

// ============================================================
// SORTEIOS / RIFAS
// ============================================================

enum RaffleStatus {
  DRAFT // criado mas ainda não publicado
  OPEN // aceitando inscrições
  CLOSED // fechado, aguardando sorteio
  DRAWN // sorteado
  CANCELLED // cancelado
}

model Raffle {
  id                    String       @id @default(cuid())
  /// Nome público do sorteio (ex.: "Rifa Dia das Mães").
  name                  String
  /// Imagem opcional pra divulgação na landing pública.
  imageUrl              String?
  /// Quando começa a aceitar inscrições.
  opensAt               DateTime
  /// Última data pra entrar.
  closesAt              DateTime
  /// Data prevista do sorteio (informativa pro cliente — sorteio é manual).
  drawAt                DateTime?
  /// Preço por número em centavos. 0 = rifa gratuita.
  ticketPriceCents      Int          @default(0)
  /// Quantidade total de números do pool.
  totalNumbers          Int          @default(100)
  /// Limite de números por cliente. null = sem limite.
  maxTicketsPerCustomer Int?
  status                RaffleStatus @default(DRAFT)
  /// Quando o último prêmio foi sorteado (todos sorteados). Status DRAWN.
  drawnAt               DateTime?
  /// Usuário que sorteou o último prêmio.
  drawnById             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prizes         RafflePrize[]
  entries        RaffleEntry[]
  referrals      RaffleReferral[]
  drawnBy        User?            @relation("RaffleDrawnBy", fields: [drawnById], references: [id])
  onlinePayments OnlinePayment[]

  @@index([status, closesAt])
}

/// Prêmio de uma rifa. Cada rifa pode ter N prêmios (ex.: dia das mães
/// com 4 ganhadores). Sorteia do prêmio com MAIOR position pro de MENOR
/// (padrão "suspense": último a sortear = prêmio principal = #1).
model RafflePrize {
  id            String    @id @default(cuid())
  raffleId      String
  /// Posição do prêmio. 1 = principal, 2 = segundo, etc. Sorteia decrescente.
  position      Int
  /// Descrição do prêmio (ex.: "Combo Costela Domingão + Coca Cola 2L").
  description   String
  /// Entry vencedora. Preenchido quando admin sorteia este prêmio.
  winnerEntryId String?   @unique
  drawnAt       DateTime?
  createdAt     DateTime  @default(now())

  raffle      Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winnerEntry RaffleEntry? @relation("PrizeWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)

  @@unique([raffleId, position])
  @@index([raffleId])
}

/// Indicação: cliente A compartilha o link da rifa com cookie ref=A, e
/// quando o cliente B se inscreve, A ganha 1 entry bônus. Funciona só
/// pra rifa GRATUITA (em rifa paga seria injusto com quem pagou).
/// 1 par (A,B) só rende 1 bônus por rifa (unique [raffleId, referredCustomerId]).
model RaffleReferral {
  id                 String   @id @default(cuid())
  raffleId           String
  /// Cliente que compartilhou (ganha o bônus).
  referrerCustomerId String
  /// Cliente que entrou pelo link (não ganha nada por isso — só o A ganha).
  referredCustomerId String
  /// A entry bônus criada pro A. Pode ser null se rifa esgotou números.
  awardedEntryId     String?  @unique
  createdAt          DateTime @default(now())

  raffle       Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  referrer     Customer     @relation("ReferrerReferrals", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referred     Customer     @relation("ReferredReferrals", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  awardedEntry RaffleEntry? @relation("ReferralAward", fields: [awardedEntryId], references: [id], onDelete: SetNull)

  /// Mesmo "amigo B" só conta 1x por rifa pra mesma rifa (evita farm
  /// de bonus quando B clica em vários links).
  @@unique([raffleId, referredCustomerId])
  @@index([referrerCustomerId])
  @@index([raffleId])
}

model RaffleEntry {
  id              String   @id @default(cuid())
  raffleId        String
  customerId      String
  /// Número escolhido pelo cliente dentro do pool da rifa (1..totalNumbers).
  /// @@unique([raffleId, number]) garante que não há dois clientes com o
  /// mesmo número na mesma rifa.
  number          Int
  /// false enquanto aguarda pagamento PIX (rifa paga). Listagens/sorteio
  /// filtram só confirmadas. Pendentes expiradas (payment OVERDUE/CANCELLED)
  /// são deletadas pra liberar o número.
  confirmed       Boolean  @default(true)
  /// FK pro OnlinePayment quando rifa paga. Vários números comprados na
  /// mesma "cesta" apontam pro mesmo pagamento (1 PIX → N entries).
  onlinePaymentId String?
  createdAt       DateTime @default(now())

  raffle        Raffle          @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  onlinePayment OnlinePayment?  @relation(fields: [onlinePaymentId], references: [id], onDelete: SetNull)
  /// Prêmio que esta entry ganhou (se ganhou algum). Relação 1-1 com
  /// RafflePrize. Uma entry só ganha um prêmio (regra: 1 cliente = 1 prêmio).
  wonPrize      RafflePrize?    @relation("PrizeWinner")
  /// Referral que premiou esta entry (se foi entry bônus de indicação).
  referralAward RaffleReferral? @relation("ReferralAward")

  @@unique([raffleId, number])
  @@index([customerId])
  @@index([onlinePaymentId])
}

// ============================================================
// CARTÃO FIDELIDADE
// ============================================================

enum LoyaltyTransactionType {
  EARN // ganho ao concluir venda
  REDEEM // resgate (vira cupom)
  ADJUST // ajuste manual (admin)
}

model LoyaltyTransaction {
  id           String                 @id @default(cuid())
  customerId   String
  type         LoyaltyTransactionType
  /// Sempre positivo. EARN soma; REDEEM e ADJUST negativo subtraem (regra no service).
  points       Int
  /// Saldo do cliente APÓS aplicar essa transação (snapshot pra histórico).
  balanceAfter Int
  /// Venda que originou o EARN (opcional — null em ADJUST/REDEEM).
  saleId       String?
  /// Cupom que originou o REDEEM (opcional).
  couponId     String?
  notes        String?
  createdAt    DateTime               @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([saleId])
}

model Coupon {
  id             String     @id @default(cuid())
  /// Código que o cliente digita no checkout (sempre uppercase).
  code           String     @unique
  description    String?
  type           CouponType
  /// PERCENT: 0..100 (ex.: 10 = 10% off). FIXED: valor em reais.
  value          Decimal    @db.Decimal(12, 4)
  /// null = ilimitado. Caso contrário, bloqueia quando usedCount atinge.
  maxUses        Int?
  usedCount      Int        @default(0)
  /// Pedido mínimo (subtotal) pra cupom ser aplicável. null = sem mínimo.
  minOrderAmount Decimal?   @db.Decimal(12, 2)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  sales     Sale[]
  campaigns Campaign[]

  @@index([active, validUntil])
}

// ============================================================
// COMPRAS / FORNECEDORES
// ============================================================

model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  cnpj          String?  @unique
  contactPerson String?
  phone         String?
  email         String?
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String?
  invoiceNumber String?
  invoiceDate   DateTime
  totalAmount   Decimal        @default(0) @db.Decimal(14, 2)
  status        PurchaseStatus @default(RASCUNHO)
  notes         String?
  userId        String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  user     User?          @relation(fields: [userId], references: [id])
  items    PurchaseItem[]

  @@index([invoiceDate])
  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id                   String    @id @default(cuid())
  purchaseId           String
  ingredientId         String
  quantity             Decimal   @db.Decimal(12, 4)
  unitCost             Decimal   @db.Decimal(12, 4)
  totalCost            Decimal   @db.Decimal(14, 2)
  lotNumber            String?
  expiryDate           DateTime?
  /// Se true, ao confirmar a compra atualiza Ingredient.unitCost e dispara cascata.
  updateIngredientCost Boolean   @default(true)
  createdAt            DateTime  @default(now())

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([ingredientId])
}

// ============================================================
// CHAT IA
// ============================================================

model ChatConversation {
  id        String   @id @default(cuid())
  title     String   @default("Nova conversa")
  userId    String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@index([userId, archived, updatedAt])
}

model ChatMessage {
  id                String   @id @default(cuid())
  conversationId    String
  role              ChatRole
  /// Para USER: string simples. Para ASSISTANT/TOOL: array de Anthropic.ContentBlock em JSON.
  content           Json
  inputTokens       Int?
  outputTokens      Int?
  cacheCreateTokens Int?
  cacheReadTokens   Int?
  createdAt         DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ============================================================
// CUSTOS FIXOS (componentes do custo fixo mensal)
// ============================================================

model FixedCostItem {
  id          String             @id @default(cuid())
  name        String
  category    FixedCostCategory
  frequency   FixedCostFrequency @default(MENSAL)
  amount      Decimal            @db.Decimal(12, 2)
  notes       String?
  active      Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  createdBy User?                  @relation(fields: [createdById], references: [id])
  history   FixedCostItemHistory[]

  @@index([category, active])
  @@index([active])
}

model FixedCostItemHistory {
  id           String             @id @default(cuid())
  itemId       String
  oldAmount    Decimal            @db.Decimal(12, 2)
  newAmount    Decimal            @db.Decimal(12, 2)
  oldFrequency FixedCostFrequency
  newFrequency FixedCostFrequency
  oldActive    Boolean
  newActive    Boolean
  changedAt    DateTime           @default(now())
  changedById  String?

  item      FixedCostItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changedBy User?         @relation(fields: [changedById], references: [id])

  @@index([itemId, changedAt])
}

model AiUsageLog {
  id                String   @id @default(cuid())
  conversationId    String?
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheCreateTokens Int      @default(0)
  cacheReadTokens   Int      @default(0)
  /// Custo estimado em USD (calculado server-side com base no modelo)
  estimatedCostUsd  Decimal  @default(0) @db.Decimal(10, 6)
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// VENDAS (PDV-light: venda-a-venda + pagamentos com taxas)
// ============================================================

model Sale {
  id           String     @id @default(cuid())
  number       Int        @unique @default(autoincrement())
  occurredAt   DateTime   @default(now())
  source       SaleSource @default(LOJA)
  status       SaleStatus @default(ABERTA)
  customerName String?
  notes        String?

  /// Cache: soma dos SaleItem.totalPrice
  totalRevenue  Decimal @default(0) @db.Decimal(14, 2)
  /// Cache: CMV real (soma dos SaleItem.totalCost). Decimais p/ alinhar com Recipe/Combo.
  totalCost     Decimal @default(0) @db.Decimal(14, 4)
  /// Cache: soma dos SalePayment.amount
  totalPaid     Decimal @default(0) @db.Decimal(14, 2)
  /// Cache: soma das SalePayment.feeAmount (cartão/app)
  totalFees     Decimal @default(0) @db.Decimal(14, 2)
  /// Cache: totalPaid - totalFees
  totalNet      Decimal @default(0) @db.Decimal(14, 2)
  /// Cache: max(0, totalRevenue - totalPaid). Cortesia/desconto em fechamento.
  totalDiscount Decimal @default(0) @db.Decimal(14, 2)

  /// Cupom aplicado (apenas no checkout público). FK opcional.
  couponId       String?
  /// Snapshot do código no momento da venda (caso o cupom seja deletado/editado).
  couponCode     String?
  /// Valor descontado pelo cupom (já calculado e validado contra o subtotal).
  couponDiscount Decimal @default(0) @db.Decimal(14, 2)

  /// Cliente vinculado (se conhecido). Auto-preenchido no checkout via match
  /// pelo telefone. Vendas criadas no admin não usam este FK por enquanto —
  /// só customerName fica preenchido como hoje.
  customerId String?

  closedAt      DateTime?
  closedById    String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  /// Etapa do pedido visível ao cliente (NOVO → ENTREGUE).
  /// Usado para tracking público em /pedido/[id] e badge de notificação no admin.
  progress                SaleProgress @default(NOVO)
  progressUpdatedAt       DateTime?
  /// Estimativa em minutos (preenchida pelo admin) — exibida ao cliente. Opcional.
  progressEstimateMinutes Int?

  /// Pré-venda (Sprint 2): vincula pedido a um evento de venda planejada.
  /// Quando preenchido, este pedido conta no SalesEventProduct.reservedQty
  /// e no SalesEventWindow.reservedCount.
  salesEventId         String?
  salesEventWindowId   String?
  /// Se pedido de pré-venda sem pagamento finalizado, a reserva expira após
  /// SalesEvent.reservationTimeoutMinutes. Job libera disponibilidade.
  reservationExpiresAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy           User?                     @relation("SaleCreatedBy", fields: [createdById], references: [id])
  closedBy            User?                     @relation("SaleClosedBy", fields: [closedById], references: [id])
  cancelledBy         User?                     @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  coupon              Coupon?                   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  customer            Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesEvent          SalesEvent?               @relation(fields: [salesEventId], references: [id], onDelete: SetNull)
  salesEventWindow    SalesEventWindow?         @relation(fields: [salesEventWindowId], references: [id], onDelete: SetNull)
  items               SaleItem[]
  payments            SalePayment[]
  onlinePayment       OnlinePayment?
  orderRequest        OrderRequest?
  campaignAttribution CampaignOrderAttribution?

  @@index([occurredAt])
  @@index([status, occurredAt])
  @@index([source])
  @@index([progress, source])
  @@index([customerId, occurredAt])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String?
  comboId    String?
  quantity   Decimal  @db.Decimal(10, 4)
  /// Snapshot do preço unitário no momento (Product.salePrice ou Combo.salePrice).
  unitPrice  Decimal  @db.Decimal(12, 2)
  /// Snapshot do custo unitário no momento (Product.totalCost ou Combo.totalCost).
  unitCost   Decimal  @db.Decimal(12, 4)
  totalPrice Decimal  @db.Decimal(14, 2)
  totalCost  Decimal  @db.Decimal(14, 4)
  notes      String?
  createdAt  DateTime @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([comboId])
}

model SalePayment {
  id         String        @id @default(cuid())
  saleId     String
  method     PaymentMethod
  amount     Decimal       @db.Decimal(14, 2)
  /// Snapshot da taxa aplicada no momento (fração 0..1).
  feePercent Decimal       @default(0) @db.Decimal(5, 4)
  feeAmount  Decimal       @default(0) @db.Decimal(14, 2)
  netAmount  Decimal       @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ============================================================
// PAGAMENTO ONLINE (Asaas)
// ============================================================

enum OnlinePaymentBillingType {
  PIX
  CREDIT_CARD
  BOLETO // futuro, não exposto na UI hoje
}

enum OnlinePaymentStatus {
  PENDING // criado, aguardando pagamento
  RECEIVED // recebido (notificação do Asaas)
  CONFIRMED // confirmado (PIX é instantâneo, cartão pode demorar)
  OVERDUE // venceu sem pagar (sistema marca via cron ou no acesso)
  REFUNDED // estornado
  FAILED // erro no processamento
  CANCELLED // cancelado pelo admin / cliente
}

model OnlinePayment {
  id              String                   @id @default(cuid())
  /// Polimórfico: paga uma Sale (saleId), N RaffleEntries (raffleId +
  /// entries vinculadas) ou o sinal de uma OrderRequest (orderRequestId).
  /// Exatamente um dos três é preenchido.
  saleId          String?                  @unique
  /// FK pra Raffle quando o pagamento é de números de rifa. Os números
  /// específicos comprados nesse PIX ficam em RaffleEntry.onlinePaymentId.
  raffleId        String?
  /// FK pra OrderRequest quando o pagamento é sinal de encomenda.
  orderRequestId  String?                  @unique
  /// ID do payment no Asaas (formato pay_xxxxx).
  asaasPaymentId  String                   @unique
  /// ID do customer no Asaas que originou esse payment.
  asaasCustomerId String
  /// ID do customer da Casa Roxa (sempre preenchido).
  customerId      String
  billingType     OnlinePaymentBillingType
  value           Decimal                  @db.Decimal(14, 2)
  status          OnlinePaymentStatus      @default(PENDING)
  invoiceUrl      String?
  pixPayload      String?
  pixQrCodeBase64 String?                  @db.Text
  dueDate         DateTime
  paidAt          DateTime?
  lastEventRaw    Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  sale          Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  raffle        Raffle?       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  orderRequest  OrderRequest? @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id])
  raffleEntries RaffleEntry[]

  @@index([status, createdAt])
  @@index([raffleId])
  @@index([orderRequestId])
  @@index([customerId])
}

// ============================================================
// PRÉ-VENDA / SALES EVENT (Sprint 2)
// ============================================================

/// Pré-venda: evento de venda planejada com lote fechado (ex.: "Sábado
/// almoço Dia das Mães"). Cliente pede até o cardápio fechar; cozinha
/// produz a quantidade vendida. Disponibilidade desce ao confirmar
/// pedido (não ao pagar) — reservas expiram se Sale não fecha em N min.
model SalesEvent {
  id                        String           @id @default(cuid())
  /// Nome público (ex.: "Almoço Sábado - Dia das Mães").
  name                      String
  /// Data prevista da entrega/retirada.
  eventDate                 DateTime         @db.Date
  status                    SalesEventStatus @default(DRAFT)
  /// Cardápio fica visível ao cliente entre opensAt e closesAt.
  opensAt                   DateTime
  closesAt                  DateTime
  /// Descrição livre exibida ao cliente (opcional).
  description               String?
  /// Reserva expira automaticamente após N minutos sem fechamento.
  /// Liberada por job. Default 120min (2h) — bom pra PIX.
  reservationTimeoutMinutes Int              @default(120)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  SalesEventProduct[]
  windows   SalesEventWindow[]
  sales     Sale[]
  createdBy User?               @relation("SalesEventCreatedBy", fields: [createdById], references: [id])

  @@index([status, eventDate])
}

/// Produto/Combo disponível no evento com limite de unidades.
model SalesEventProduct {
  id             String   @id @default(cuid())
  salesEventId   String
  /// Polimórfico: ou productId ou comboId (similar a SaleItem).
  productId      String?
  comboId        String?
  /// Quantidade máxima disponível (ex.: 40 frangos).
  quantityLimit  Int
  /// Cache: soma das unidades vendidas/reservadas. Atualizado em transação
  /// ao confirmar pedido. Liberado por job quando reserva expira.
  reservedQty    Int      @default(0)
  /// Preço override opcional pro evento (ex.: combo dia das mães).
  /// Se null, usa Product.salePrice ou Combo.salePrice padrão.
  unitPriceCents Int?
  /// Ordem de exibição no cardápio do evento (asc).
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  salesEvent SalesEvent @relation(fields: [salesEventId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  combo      Combo?     @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@unique([salesEventId, productId])
  @@unique([salesEventId, comboId])
  @@index([salesEventId])
}

// ============================================================
// ENCOMENDAS (Sprint 3)
// ============================================================

enum OrderRequestStatus {
  PENDENTE // criada pelo cliente, aguarda admin aprovar/recusar
  APROVADA // admin aceitou; Sale criada
  RECUSADA // admin recusou (com razão)
  EM_PRODUCAO // produção iniciada
  PRONTA // produzida, aguardando retirada/entrega
  ENTREGUE // finalizada
  CANCELADA // cancelada após aprovação
}

enum OrderRequestSource {
  SITE // cliente preencheu form em /encomenda
  ADMIN // admin cadastrou manualmente (cliente ligou/WhatsApp)
}

enum OrderRequestDeliveryMode {
  PICKUP
  DELIVERY
}

/// Encomenda — pedido com data/hora desejada futura (pelo menos
/// Settings.orderLeadTimeHours horas adiante). Aprovação manual do admin
/// converte em Sale. Diferente de pré-venda (SalesEvent) que é lote
/// fechado pra data única coletiva.
model OrderRequest {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement())

  // Cliente (snapshot — customerId opcional liga ao cadastro)
  customerName  String
  customerPhone String
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Pedido
  requestedFor      DateTime
  deliveryMode      OrderRequestDeliveryMode @default(PICKUP)
  // Endereço (se DELIVERY)
  address           String?
  addressNumber     String?
  addressComplement String?
  neighborhood      String?
  reference         String?
  notes             String?

  // Status / origem
  status          OrderRequestStatus @default(PENDENTE)
  source          OrderRequestSource @default(SITE)
  rejectionReason String?
  adminNotes      String?

  // Aprovação
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("OrderRequestApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  // Sinal opcional (admin decide na hora de aprovar)
  depositRequiredCents Int?
  depositPaidAt        DateTime?

  // Quando aprovada, link com Sale criada (1:1 opcional)
  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("OrderRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items          OrderRequestItem[]
  depositPayment OnlinePayment?

  @@index([status, requestedFor])
  @@index([requestedFor])
  @@index([customerId])
}

model OrderRequestItem {
  id                String  @id @default(cuid())
  orderRequestId    String
  productId         String?
  comboId           String?
  /// Quantidade pedida. Decimal pra alinhar com SaleItem.
  quantity          Decimal @db.Decimal(10, 4)
  /// Snapshot do preço unitário no momento do pedido (Product.salePrice ou Combo.salePrice).
  unitPriceSnapshot Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  orderRequest OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  combo        Combo?       @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@index([orderRequestId])
}

/// Janela de retirada/entrega do evento. Ex.: "Sáb 11h-12h" com cap=10.
model SalesEventWindow {
  id            String               @id @default(cuid())
  salesEventId  String
  kind          SalesEventWindowKind
  /// Rótulo exibido ao cliente (ex.: "Sábado 11h às 12h - retirada").
  label         String
  /// Início e fim do range (data + hora).
  startsAt      DateTime
  endsAt        DateTime
  /// Capacidade de pedidos no slot. 0 = ilimitada.
  capacity      Int                  @default(0)
  /// Cache: pedidos já reservados nesse slot.
  reservedCount Int                  @default(0)
  /// Ordem de exibição.
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now())

  salesEvent SalesEvent @relation(fields: [salesEventId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@index([salesEventId, startsAt])
}

// ============================================================
// CAMPANHAS (Sprint 5)
// ============================================================

/// Campanha de marketing — admin define mensagem, escolhe público fixo
/// (audienceKey) e dispara. Cada Customer da audiência vira um
/// CampaignDelivery com status próprio. Atribuição de vendas via
/// CampaignOrderAttribution (gerada ao usar o cupom da campanha no checkout).
model Campaign {
  id               String              @id @default(cuid())
  name             String
  /// Template da mensagem. Suporta {nome} (primeiro nome) e {cupom}.
  message          String              @db.Text
  channel          CampaignChannel     @default(WHATSAPP)
  audienceKey      CampaignAudienceKey
  status           CampaignStatus      @default(DRAFT)
  /// Cupom gerado pra atribuição automática (opcional).
  couponId         String?
  coupon           Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Snapshot do tamanho da audiência no momento do disparo.
  audienceSnapshot Int                 @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?

  createdById String?
  createdBy   User?    @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries   CampaignDelivery[]
  attributions CampaignOrderAttribution[]

  @@index([status, createdAt])
}

model CampaignDelivery {
  id              String                 @id @default(cuid())
  campaignId      String
  campaign        Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          CampaignDeliveryStatus @default(PENDING)
  /// Telefone normalizado usado no envio (snapshot).
  phoneSnapshot   String?
  /// Mensagem renderizada com substituições (snapshot).
  messageSnapshot String?                @db.Text
  /// FK pro WhatsAppMessageLog gerado, se SENT.
  whatsappLogId   String?
  errorMessage    String?
  sentAt          DateTime?
  createdAt       DateTime               @default(now())

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

/// Liga uma Sale à campanha que provavelmente gerou ela. Criado quando
/// o cliente usa o cupom da campanha no checkout, ou manualmente pelo admin.
model CampaignOrderAttribution {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  saleId     String   @unique
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([campaignId])
}
