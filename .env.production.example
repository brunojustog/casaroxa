# ==============================================================
# Variáveis de produção — VPS Debian 12 + Docker Compose + Traefik
# ==============================================================
# Copie este arquivo para .env.production no servidor (NÃO COMMITAR)
# e preencha os valores reais.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# Veja docs/DEPLOY.md para o passo-a-passo completo.

# ----- Domínios + SSL -----
# Sem 'https://' nem barra final.
#
# PUBLIC_DOMAIN: cardápio online + landing pública (cliente final).
# ADMIN_DOMAIN: login + sistema interno (admin).
# O middleware do Next bloqueia acesso cruzado: tentar /dashboard em
# PUBLIC_DOMAIN redireciona para ADMIN_DOMAIN, e vice-versa.
PUBLIC_DOMAIN=casaroxa.com.br
ADMIN_DOMAIN=gestao.casaroxa.com.br

# E-mail para registrar no Let's Encrypt (recebe avisos de expiração).
LETSENCRYPT_EMAIL=

# ----- Postgres (interno ao Compose) -----
# Use senha forte e única. Postgres não é exposto fora da rede interna do Docker.
POSTGRES_USER=casaroxa
POSTGRES_PASSWORD=
POSTGRES_DB=casa_roxa

# ----- Auth.js -----
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# ----- Nome público do app (aparece em PDFs, abas, etc) -----
NEXT_PUBLIC_APP_NAME="Casa Roxa — Gestão"

# ----- Chat IA (Anthropic) -----
# Conta em console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_MONTHLY_BUDGET_USD=30

# ----- Admin inicial (criado pelo seed na primeira execução) -----
# Use senha forte e ÚNICA — esta é a credencial inicial do sistema.
# Você pode mudar depois, mas a senha do seed é o "fallback".
SEED_ADMIN_EMAIL=admin@casaroxa.com.br
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Administrador"
