# ==============================================================
# Variáveis de produção — Docker Swarm + Portainer
# ==============================================================
# Copie/cole o conteúdo no Portainer (Stack → Environment variables)
# ou crie um .env neste mesmo diretório se for fazer deploy via CLI:
#
#   docker stack deploy -c deploy/casa-roxa.stack.yml casa-roxa --with-registry-auth
#
# Veja docs/DEPLOY_SWARM.md para o passo-a-passo completo.

# ----- Domínios -----
# Sem 'https://' nem barra final.
# PUBLIC_DOMAIN: cardápio online + landing pública (cliente final).
# ADMIN_DOMAIN: login + sistema interno (admin).
# O middleware do Next bloqueia acesso cruzado: /dashboard em PUBLIC_DOMAIN
# redireciona para ADMIN_DOMAIN, e vice-versa.
PUBLIC_DOMAIN=casaroxa.com.br
ADMIN_DOMAIN=gestao.casaroxa.com.br

# ----- Postgres (interno à rede da stack) -----
# Use senha forte e única. Postgres só fica na rede 'casa-roxa-internal'.
POSTGRES_USER=casaroxa
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=casa_roxa

# DATABASE_URL é montada automaticamente no stack.yml a partir das
# variáveis acima. Mantenha aqui apenas se quiser apontar para um
# Postgres externo ao stack (por exemplo, um banco gerenciado).
# DATABASE_URL=postgresql://casaroxa:troque_esta_senha@postgres:5432/casa_roxa?schema=public

# ----- Auth.js -----
# Gere com: openssl rand -base64 32
AUTH_SECRET=gere_um_secret_forte
AUTH_TRUST_HOST=true

# ----- Nome público (aparece em PDFs, abas, etc) -----
NEXT_PUBLIC_APP_NAME=Casa Roxa — Gestão

# ----- Chat IA (Anthropic) -----
# Conta em console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=coloque_sua_chave
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_MONTHLY_BUDGET_USD=30

# ----- Admin inicial (criado pelo seed na primeira execução) -----
# Senha forte e ÚNICA — credencial inicial do sistema. Pode ser trocada
# depois (manualmente no banco — UI de troca de senha não existe ainda).
SEED_ADMIN_EMAIL=admin@casaroxa.com.br
SEED_ADMIN_PASSWORD=troque_esta_senha
SEED_ADMIN_NAME=Administrador

NODE_ENV=production
